{
    "name": "mchtylmz/filament-spreadsheet-editor",
    "description": "A Filament v5 plugin that provides an Excel-like spreadsheet editor for Eloquent models.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "laravel",
        "livewire",
        "spreadsheet",
        "tabulator"
    ],
    "authors": [
        {
            "name": "Mivento"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/bus": "^12.69|^13.30",
        "illuminate/contracts": "^12.69|^13.30",
        "illuminate/database": "^12.69|^13.30",
        "illuminate/filesystem": "^12.69|^13.30",
        "illuminate/http": "^12.69|^13.30",
        "illuminate/support": "^12.69|^13.30",
        "illuminate/validation": "^12.69|^13.30",
        "livewire/livewire": "^4.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Mivento\\FilamentSpreadsheetEditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mivento\\FilamentSpreadsheetEditor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=512M",
        "build": "npm run build",
        "ci": [
            "composer validate --strict",
            "composer audit --locked",
            "@format:test",
            "@analyse",
            "@test",
            "@frontend:test",
            "@build"
        ],
        "format": "pint src config routes tests database/migrations demo",
        "format:test": "pint --test src config routes tests database/migrations demo",
        "frontend:test": "npm test",
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mivento\\FilamentSpreadsheetEditor\\FilamentSpreadsheetEditorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
